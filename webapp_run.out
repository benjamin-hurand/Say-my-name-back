2026-01-08T16:02:53.018+01:00 DEBUG 16256 --- [webapp] [0.0-8080-exec-8] org.hibernate.SQL                        : SELECT k.*
FROM knowledges k
JOIN (
  SELECT
    k2.id,
    COALESCE(ks2.last_answer_at, '1970-01-01') AS last_answer_sort,
    ROW_NUMBER() OVER (
      PARTITION BY k2.person_id
      ORDER BY k2.next_review_date ASC, COALESCE(ks2.last_answer_at, '1970-01-01') ASC, k2.id ASC
    ) AS rn
  FROM knowledges k2
  LEFT JOIN knowledge_stats ks2
    ON ks2.organization_id = k2.organization_id
   AND ks2.user_id = k2.user_id
   AND ks2.game_mode_id = k2.game_mode_id
   AND ks2.knowledge_id = k2.id
  WHERE k2.organization_id = ?
    AND k2.user_id = ?
    AND k2.game_mode_id = ?
    AND k2.status IN (?,?)
    AND (? IS NULL OR k2.person_id <> ?)
    AND (? IS NULL OR k2.person_id <> ?)
    AND ( ? = false OR EXISTS (
        SELECT 1
        FROM user_subscriptions s
        WHERE s.organization_id = ?
          AND s.user_id = ?
          AND s.person_id = k2.person_id
    ))
    AND COALESCE(ks2.error_streak, 0) <= ?
    AND COALESCE(ks2.avg_rt_recent, 0) <= ?
    AND COALESCE(ks2.help_recent, 0) <= ?
    AND COALESCE(ks2.attempts_recent, 0) >= ?
) ranked ON ranked.id = k.id
WHERE ranked.rn = 1
ORDER BY k.next_review_date ASC, ranked.last_answer_sort ASC, k.id ASC
LIMIT ?

